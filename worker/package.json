{
  "name": "parzr-reports",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker + D1 for Parzr's anonymous suggestion reports",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply parzr-reports --local",
    "migrate": "wrangler d1 migrations apply parzr-reports --remote",
    "deploy": "wrangler deploy",
    "fix-queue": "node scripts/export-fix-queue.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "wrangler": "4.151.2"
  }
}
