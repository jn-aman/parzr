{
  "name": "parzr-reports",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker + D1 for Parzr's anonymous suggestion reports",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:d1": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test-d1",
    "check": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply parzr-reports --local",
    "migrate": "wrangler d1 migrations apply parzr-reports --remote",
    "deploy": "wrangler deploy",
    "fix-queue": "node scripts/export-fix-queue.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.5",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.6"
  }
}
