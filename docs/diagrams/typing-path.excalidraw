{"id":"s1_body","type":"text","x":280,"y":570,"width":367,"height":114,"angle":0,"strokeColor":"#5B6B64","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":160005,"version":1,"versionNonce":160006,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"A pause waits 35 ms: 7/18 of the Checking delay\nsetting (90 ms default, 20 ms floor).\nKeys under 80 ms apart wait the full setting.\nA space, Return or punctuation key checks at\nonce, when the editor reports the change.\nOne keystroke fires 3 triggers; the timer\nmoves only once.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"A pause waits 35 ms: 7/18 of the Checking delay\nsetting (90 ms default, 20 ms floor).\nKeys under 80 ms apart wait the full setting.\nA space, Return or punctuation key checks at\nonce, when the editor reports the change.\nOne keystroke fires 3 triggers; the timer\nmoves only once.","lineHeight":1.25},
